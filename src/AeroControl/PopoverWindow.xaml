<Window x:Class="AeroControl.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AeroControl.Views"
        Title="Aero Control" Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Border x:Name="Shell" Margin="16" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20" Padding="14">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" /></Border.Effect>
        <Border.RenderTransform><TranslateTransform x:Name="Slide" Y="0" /></Border.RenderTransform>
        <StackPanel>
            <DockPanel Margin="4,2,4,10">
                <Button DockPanel.Dock="Right" Width="32" Height="32" Click="OpenSettings_Click" ToolTip="Open Aero Control" AutomationProperties.Name="Open Aero Control settings" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="16" Background="{DynamicResource Tile}"><Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource LogoPath}" /></Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AERO 14 OLED" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding BatteryText}" Style="{StaticResource SubText}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Mode -->
            <Border Background="{DynamicResource Tile}" CornerRadius="16" Padding="12">
                <StackPanel>
                    <TextBlock Text="MODE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" Margin="2,0,0,10" />
                    <ItemsControl ItemsSource="{Binding ModeItems}" Margin="-4">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="popMode" Style="{StaticResource ModeTile}" Margin="4" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Dot" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Tile}">
                                            <v:Icon x:Name="Ic" Data="{Binding Glyph}" Stroke="{DynamicResource Text}" Width="16" Height="16" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Short}" FontSize="11" Foreground="{DynamicResource Sub}" />
                                        </StackPanel>
                                    </StackPanel>
                                </RadioButton>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Accent}" />
                                        <Setter TargetName="Ic" Property="Stroke" Value="White" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Fans + charge limit -->
            <UniformGrid Columns="2" Margin="-5,5,-5,0">
                <Button Style="{StaticResource TileButton}" Margin="5" Click="Fans_Click" AutomationProperties.Name="Fans, open performance settings">
                    <StackPanel>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Accent}" HorizontalAlignment="Left"><v:Icon Data="{StaticResource IcoFan}" Width="16" Height="16" /></Border>
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold"><Run Text="Fans · " /><Run Text="{Binding FanText, Mode=OneWay}" /></TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Sub}"><Run Text="{Binding Fan1PctText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Fan2PctText, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Margin="5" Click="Charge_Click" AutomationProperties.Name="Charge limit, click to change">
                    <StackPanel>
                        <Border Width="30" Height="30" CornerRadius="15" Background="#30D158" HorizontalAlignment="Left"><v:Icon Data="{StaticResource IcoCharge}" Width="16" Height="16" /></Border>
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold"><Run Text="Charge limit · " /><Run Text="{Binding ChargeLimitText, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding ChargeName}" FontSize="11" Foreground="{DynamicResource Sub}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Sliders -->
            <Border Background="{DynamicResource Tile}" CornerRadius="16" Padding="14,12" Margin="0,5,0,0">
                <StackPanel>
                    <TextBlock Text="DISPLAY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" />
                    <DockPanel Margin="0,6,0,12">
                        <v:Icon Data="{StaticResource IcoSun}" Stroke="{DynamicResource Sub}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" AutomationProperties.Name="Display brightness" />
                    </DockPanel>
                    <TextBlock Text="KEYBOARD" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" />
                    <DockPanel Margin="0,6,0,0">
                        <v:Icon Data="{StaticResource IcoKeyboard}" Stroke="{DynamicResource Sub}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Slider Minimum="0" Maximum="100" SmallChange="2" Value="{Binding Keyboard}" AutomationProperties.Name="Keyboard backlight" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Quick toggles -->
            <UniformGrid Columns="3" Margin="-5,5,-5,0">
                <ToggleButton Margin="5" IsChecked="{Binding AutoRefresh}" Style="{StaticResource Chip}" Tag="{StaticResource IcoRefresh}" Content="Auto 90 Hz" />
                <ToggleButton Margin="5" IsChecked="{Binding LowRes}" Style="{StaticResource Chip}" Tag="{StaticResource IcoLowRes}" Content="Low res on battery" />
                <ToggleButton Margin="5" IsChecked="{Binding WarmWhite}" Style="{StaticResource Chip}" Tag="{StaticResource IcoWarm}" Content="Warm white" />
            </UniformGrid>

            <!-- Live readout -->
            <UniformGrid Columns="4" Margin="4,10,4,2">
                <StackPanel><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"><Run Text="{Binding CpuTemp, Mode=OneWay}" />°</TextBlock><TextBlock Text="CPU" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource Sub}" /></StackPanel>
                <StackPanel><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold"><Run Text="{Binding GpuTemp, Mode=OneWay}" />°</TextBlock><TextBlock Text="GPU" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource Sub}" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding Fan1PctText}" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="FAN" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource Sub}" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding BatteryPercentText}" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="BATTERY" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource Sub}" /></StackPanel>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
