<Window x:Class="AeroControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:AeroControl.Views"
        Title="Aero Control" Icon="Assets/AeroControl.ico" Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,14" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,14" Height="20">
                    <Ellipse Width="12" Height="12" Fill="{DynamicResource Sub}" Opacity="0.35" VerticalAlignment="Center" />
                    <TextBlock Text="Aero Control" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" />
                </StackPanel>

                <RadioButton DockPanel.Dock="Top" GroupName="nav" IsChecked="{Binding IsAbout}" Style="{StaticResource NavItem}" Height="60" Margin="0,0,0,12" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <v:Icon Data="M4 6h16v10H4zM2 18h20" Stroke="{DynamicResource Sub}" Width="22" Height="22" Thickness="1.4" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AERO 14 OLED" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            <TextBlock Text="BMF · i7-13620H" FontSize="11" Foreground="{DynamicResource Sub}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </RadioButton>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton GroupName="nav" IsChecked="{Binding IsHome}" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#5E5CE6"><v:Icon Data="{StaticResource IcoHome}" Width="14" Height="14" Thickness="2.2" /></Border>
                            <TextBlock Text="Home" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="nav" IsChecked="{Binding IsPerf}" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#FF9F0A"><v:Icon Data="{StaticResource IcoPerf}" Width="14" Height="14" Thickness="2.2" /></Border>
                            <TextBlock Text="Performance" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="nav" IsChecked="{Binding IsBattery}" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#30D158"><v:Icon Data="{StaticResource IcoBattery}" Width="14" Height="14" Thickness="2.2" /></Border>
                            <TextBlock Text="Battery" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="nav" IsChecked="{Binding IsDisplay}" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#0A84FF"><v:Icon Data="{StaticResource IcoDisplay}" Width="14" Height="14" Thickness="2.2" /></Border>
                            <TextBlock Text="Display" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="nav" IsChecked="{Binding IsKeyboard}" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#8E8E93"><v:Icon Data="{StaticResource IcoKeyboard}" Width="14" Height="14" Thickness="2.2" /></Border>
                            <TextBlock Text="Keyboard" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="nav" IsChecked="{Binding IsSettings}" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6" Background="#636366"><v:Icon Data="{StaticResource IcoSettings}" Width="14" Height="14" Thickness="2.2" /></Border>
                            <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
                    <TextBlock Text="{Binding BatteryText}" Style="{StaticResource SubText}" FontSize="11" />
                    <TextBlock Text="Running alongside GIGABYTE Control Center" Style="{StaticResource SubText}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Height="52" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding PageTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"><v:Icon Data="M6 12h12" Stroke="{DynamicResource Sub}" Width="14" Height="14" Thickness="1.5" /></Button>
                        <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize"><v:Icon Data="M7 7h10v10H7z" Stroke="{DynamicResource Sub}" Width="14" Height="14" Thickness="1.5" /></Button>
                        <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close to tray" AutomationProperties.Name="Close"><v:Icon Data="M7 7l10 10M17 7L7 17" Stroke="{DynamicResource Sub}" Width="14" Height="14" Thickness="1.5" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer>
                <Grid Margin="32,24,32,32">

                    <!-- ===== HOME ===== -->
                    <StackPanel Visibility="{Binding IsHome, Converter={StaticResource Vis}}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding ModeCaption}" Style="{StaticResource SubText}" />
                                <TextBlock Text="{Binding ModeName}" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold" Margin="0,2,0,2" />
                                <TextBlock Text="{Binding ModeDetail}" Style="{StaticResource SubText}" FontSize="13" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Field}" CornerRadius="9" Padding="2">
                                <ItemsControl ItemsSource="{Binding ModeItems}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><RadioButton GroupName="homeMode" Style="{StaticResource Segment}" Height="30" Padding="16,0" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>

                        <UniformGrid Columns="4" Margin="-6,22,-6,0">
                            <Border Style="{StaticResource CardBox}" CornerRadius="14" Padding="16" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="CPU" Style="{StaticResource SubText}" />
                                    <TextBlock Margin="0,6"><Run Text="{Binding CpuTemp, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /><Run Text=" °C" FontSize="14" Foreground="{DynamicResource Sub}" /></TextBlock>
                                    <ProgressBar Height="4" Maximum="1" Value="{Binding CpuPct, Mode=OneWay}" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" BorderThickness="0" />
                                    <TextBlock Text="i7-13620H" Style="{StaticResource SubText}" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" CornerRadius="14" Padding="16" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="GPU" Style="{StaticResource SubText}" />
                                    <TextBlock Margin="0,6"><Run Text="{Binding GpuTemp, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /><Run Text=" °C" FontSize="14" Foreground="{DynamicResource Sub}" /></TextBlock>
                                    <ProgressBar Height="4" Maximum="1" Value="{Binding GpuPct, Mode=OneWay}" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" BorderThickness="0" />
                                    <TextBlock Text="RTX 4050 Laptop" Style="{StaticResource SubText}" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" CornerRadius="14" Padding="16" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="Fan 1" Style="{StaticResource SubText}" />
                                    <TextBlock Margin="0,6"><Run Text="{Binding Fan1, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /><Run Text=" rpm" FontSize="14" Foreground="{DynamicResource Sub}" /></TextBlock>
                                    <ProgressBar Height="4" Maximum="1" Value="{Binding Fan1Pct, Mode=OneWay}" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" BorderThickness="0" />
                                    <TextBlock Text="{Binding Fan1Duty}" Style="{StaticResource SubText}" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" CornerRadius="14" Padding="16" Margin="6">
                                <StackPanel>
                                    <TextBlock Text="Fan 2" Style="{StaticResource SubText}" />
                                    <TextBlock Margin="0,6"><Run Text="{Binding Fan2, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" /><Run Text=" rpm" FontSize="14" Foreground="{DynamicResource Sub}" /></TextBlock>
                                    <ProgressBar Height="4" Maximum="1" Value="{Binding Fan2Pct, Mode=OneWay}" Foreground="{DynamicResource Accent}" Background="{DynamicResource Field}" BorderThickness="0" />
                                    <TextBlock Text="{Binding Fan2Duty}" Style="{StaticResource SubText}" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="2" Margin="-6,6,-6,0">
                            <Border Style="{StaticResource CardBox}" CornerRadius="14" Padding="18" Margin="6">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Battery" FontWeight="SemiBold" /><Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Options" Click="GoBattery_Click" Style="{StaticResource LinkButton}" /></DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,24,0"><TextBlock Text="Charge limit" Style="{StaticResource SubText}" FontSize="11" /><TextBlock Text="{Binding ChargeLimitText}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel Margin="0,0,24,0"><TextBlock Text="Health" Style="{StaticResource SubText}" FontSize="11" /><TextBlock Text="{Binding Health}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel><TextBlock Text="Cycles" Style="{StaticResource SubText}" FontSize="11" /><TextBlock Text="{Binding Cycles}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" CornerRadius="14" Padding="18" Margin="6">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Display" FontWeight="SemiBold" /><Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Options" Click="GoDisplay_Click" Style="{StaticResource LinkButton}" /></DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,24,0"><TextBlock Text="Resolution" Style="{StaticResource SubText}" FontSize="11" /><TextBlock Text="{Binding ResolutionText}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel Margin="0,0,24,0"><TextBlock Text="Refresh" Style="{StaticResource SubText}" FontSize="11" /><TextBlock Text="{Binding RefreshText}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel><TextBlock Text="White point" Style="{StaticResource SubText}" FontSize="11" /><TextBlock Text="{Binding WhiteText}" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- ===== PERFORMANCE ===== -->
                    <StackPanel Visibility="{Binding IsPerf, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding ModeItems}" Margin="-6,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="perfMode" Style="{StaticResource ChoiceCard}" Margin="6" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <StackPanel>
                                            <Border x:Name="Dot" Width="32" Height="32" CornerRadius="9" HorizontalAlignment="Left" Background="{DynamicResource Field}">
                                                <v:Icon x:Name="Ic" Data="{Binding Glyph}" Width="18" Height="18" Stroke="{DynamicResource Sub}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" Margin="0,6,0,0" LineHeight="17" />
                                        </StackPanel>
                                    </RadioButton>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="Ic" Property="Stroke" Value="White" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SectionTitle}" Margin="4,22,0,8"><Run Text="{Binding ModeName, Mode=OneWay}" /><Run Text=" does" /></TextBlock>
                        <Border Style="{StaticResource CardBox}">
                            <ItemsControl ItemsSource="{Binding ModeRows}" AlternationCount="100">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="R" Style="{StaticResource Row}" MinHeight="44">
                                            <DockPanel><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><TextBlock Text="{Binding Value}" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter TargetName="R" Property="BorderThickness" Value="0" /></Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <DockPanel Margin="4,22,4,8">
                            <TextBlock Text="Custom fan curve" FontWeight="SemiBold" />
                            <TextBlock Text="Drag the points. Written to the fan controller when you let go." Style="{StaticResource SubText}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border Style="{StaticResource CardBox}" Padding="16,16,16,10">
                            <v:FanCurveEditor x:Name="CurveEditor" Height="230" Points="{Binding Curve}" Accent="{DynamicResource Accent}" LineBrush="{DynamicResource Line}" LabelBrush="{DynamicResource Sub}" KnobFill="{DynamicResource Card}" />
                        </Border>
                    </StackPanel>

                    <!-- ===== BATTERY ===== -->
                    <StackPanel Visibility="{Binding IsBattery, Converter={StaticResource Vis}}">
                        <TextBlock Text="Charge limit" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <RadioButton GroupName="charge" IsChecked="{Binding ChargeFull}" Style="{StaticResource RadioRow}" Tag="100%">
                                    <StackPanel><TextBlock Text="Full capacity" FontWeight="Medium" /><TextBlock Text="Charge to 100%. Best when you need every minute away from the charger." Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="charge" IsChecked="{Binding ChargeBalanced}" Style="{StaticResource RadioRow}" Tag="80%" BorderThickness="0,1,0,0">
                                    <StackPanel><TextBlock Text="Balanced" FontWeight="Medium" /><TextBlock Text="Stop at 80%. A good everyday choice." Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="charge" IsChecked="{Binding ChargeHealth}" Style="{StaticResource RadioRow}" Tag="60%" BorderThickness="0,1,0,0">
                                    <StackPanel><TextBlock Text="Maximum battery health" FontWeight="Medium" /><TextBlock Text="Stop at 60%. For a laptop that lives on the charger." Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Battery health" Style="{StaticResource SectionTitle}" Margin="4,22,0,8" />
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Border Style="{StaticResource FirstRow}" MinHeight="44"><DockPanel><TextBlock Text="Condition" VerticalAlignment="Center" /><TextBlock Text="{Binding Health}" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border>
                                <Border Style="{StaticResource Row}" MinHeight="44"><DockPanel><TextBlock Text="Cycle count" VerticalAlignment="Center" /><TextBlock Text="{Binding Cycles}" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border>
                                <Border Style="{StaticResource Row}" MinHeight="44"><DockPanel><TextBlock Text="Status" VerticalAlignment="Center" /><TextBlock Text="{Binding BatteryText}" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== DISPLAY ===== -->
                    <StackPanel Visibility="{Binding IsDisplay, Converter={StaticResource Vis}}">
                        <TextBlock Text="Panel" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Border Style="{StaticResource FirstRow}">
                                    <DockPanel>
                                        <v:Icon Data="{StaticResource IcoSun}" Stroke="{DynamicResource Sub}" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Brightness" Width="90" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"><Run Text="{Binding Brightness, Mode=OneWay}" />%</TextBlock>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Brightness}" VerticalAlignment="Center" AutomationProperties.Name="Brightness" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoRefresh}" AutomationProperties.Name="Auto refresh rate" />
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Auto refresh rate" /><TextBlock Text="90 Hz plugged in, 60 Hz on battery" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LowRes}" AutomationProperties.Name="Lower resolution on battery" />
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Lower resolution on battery" /><TextBlock Text="{Binding BatteryResolutionText}" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Color" Style="{StaticResource SectionTitle}" Margin="4,22,0,8" />
                        <Border Style="{StaticResource CardBox}" Padding="16,14">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Field}" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="white" Style="{StaticResource Segment}" Content="5800K" IsChecked="{Binding White5800}" />
                                        <RadioButton GroupName="white" Style="{StaticResource Segment}" Content="6000K" IsChecked="{Binding White6000}" />
                                        <RadioButton GroupName="white" Style="{StaticResource Segment}" Content="6500K · Native" IsChecked="{Binding White6500}" />
                                        <RadioButton GroupName="white" Style="{StaticResource Segment}" Content="6800K" IsChecked="{Binding White6800}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="White point" /><TextBlock Text="6500K is the panel's native white" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="OLED Care" Style="{StaticResource SectionTitle}" Margin="4,22,0,8" />
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Border Style="{StaticResource FirstRow}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding PixelShift}" AutomationProperties.Name="Pixel shift" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Pixel shift" /><TextBlock Text="Nudges desktop icons by 1 px when idle for 30 min" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoDim}" AutomationProperties.Name="Auto-dim when idle" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Auto-dim when idle" /><TextBlock Text="Fades to 70% after 5 minutes idle, to 35% after 10. Any input brings it back." Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DarkMode}" AutomationProperties.Name="Dark mode" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Dark mode" /><TextBlock Text="Darker pixels draw less power and wear less on OLED" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoHideTaskbar}" AutomationProperties.Name="Auto-hide taskbar" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Auto-hide taskbar" /><TextBlock Text="Keeps a static bar from sitting on the panel" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Transparency}" AutomationProperties.Name="Taskbar transparency" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Taskbar transparency" /><TextBlock Text="Lets the wallpaper show through the taskbar" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}"><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Run now…" Click="PixelRefresh_Click" VerticalAlignment="Center" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Pixel refresh" /><TextBlock Text="Plays a full-screen pattern to even out pixel wear. Any key or click stops it." Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== KEYBOARD ===== -->
                    <StackPanel Visibility="{Binding IsKeyboard, Converter={StaticResource Vis}}">
                        <Border Style="{StaticResource CardBox}" CornerRadius="14" Padding="28">
                            <StackPanel HorizontalAlignment="Center">
                                <ItemsControl x:Name="KeyGrid" Width="520" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="22" Margin="2.5" CornerRadius="4" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                                <Border CornerRadius="4" BorderBrush="White" BorderThickness="1" Opacity="{Binding DataContext.KeyGlow, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Border.Effect><DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.6" /></Border.Effect>
                                                </Border>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubText}" Margin="0,16,0,0"><Run Text="White backlight · " /><Run Text="{Binding KeyboardText, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}" Margin="0,22,0,0">
                            <StackPanel>
                                <Border Style="{StaticResource FirstRow}">
                                    <DockPanel>
                                        <TextBlock Text="Backlight" Width="90" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Text="{Binding KeyboardText}" />
                                        <Slider Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" Value="{Binding Keyboard}" VerticalAlignment="Center" AutomationProperties.Name="Keyboard backlight" />
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Row}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding KbAutoOff}" AutomationProperties.Name="Turn off after 1 minute idle" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Turn off after 1 minute idle" /><TextBlock Text="Handled by the keyboard itself, even when the app is closed" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding KbFollow}" AutomationProperties.Name="Follow performance mode" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Follow performance mode" /><TextBlock Text="Each mode remembers its own brightness" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== ABOUT ===== -->
                    <StackPanel Visibility="{Binding IsAbout, Converter={StaticResource Vis}}" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Viewbox Width="240" Height="150">
                            <Canvas Width="240" Height="150">
                                <Rectangle Canvas.Left="34" Canvas.Top="6" Width="172" Height="112" RadiusX="8" RadiusY="8" Fill="{DynamicResource Field}" Stroke="{DynamicResource Sub}" StrokeThickness="1.5" />
                                <Rectangle Canvas.Left="42" Canvas.Top="14" Width="156" Height="96" RadiusX="3" RadiusY="3" Fill="Black" />
                                <Path Data="M8 124h224l-8 12a6 6 0 0 1-5 3H21a6 6 0 0 1-5-3z" Fill="{DynamicResource Field}" Stroke="{DynamicResource Sub}" StrokeThickness="1.5" />
                                <Path Data="M100 124h40v3a3 3 0 0 1-3 3h-34a3 3 0 0 1-3-3z" Fill="{DynamicResource Line}" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="AERO 14 OLED" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Text="BMF · 14-inch, 2880 × 1800 OLED" Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,4,0,18" />
                        <Border Style="{StaticResource CardBox}" Width="460">
                            <ItemsControl ItemsSource="{Binding About}" AlternationCount="100">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="R" Style="{StaticResource Row}" MinHeight="40" Padding="16,0">
                                            <DockPanel><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><TextBlock Text="{Binding Value}" Foreground="{DynamicResource Sub}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter TargetName="R" Property="BorderThickness" Value="0" /></Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ===== SETTINGS ===== -->
                    <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource Vis}}">
                        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Border Style="{StaticResource FirstRow}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Start with Windows" /><TextBlock Text="Runs in the tray at sign-in, without a permission prompt" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DarkAppearance}" AutomationProperties.Name="Dark appearance" /><StackPanel VerticalAlignment="Center"><TextBlock Text="Dark appearance" /><TextBlock Text="The look of Aero Control itself" Style="{StaticResource SubText}" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Swatch}" Background="#0A84FF" Tag="#0A84FF" Click="Accent_Click" AutomationProperties.Name="Blue" />
                                            <Button Style="{StaticResource Swatch}" Background="#64D2FF" Tag="#64D2FF" Click="Accent_Click" AutomationProperties.Name="Ice blue" />
                                            <Button Style="{StaticResource Swatch}" Background="#8E8E93" Tag="#8E8E93" Click="Accent_Click" AutomationProperties.Name="Graphite" />
                                            <Button Style="{StaticResource Swatch}" Background="#30D158" Tag="#30D158" Click="Accent_Click" AutomationProperties.Name="Green" />
                                            <Button Style="{StaticResource Swatch}" Background="#FF9F0A" Tag="#FF9F0A" Click="Accent_Click" AutomationProperties.Name="Orange" />
                                        </StackPanel>
                                        <TextBlock Text="Accent color" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
